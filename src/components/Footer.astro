---
import { SITE, FOOTER_LINKS, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__bar" aria-hidden="true"></div>
  <div class="footer__glow" aria-hidden="true"></div>
  <div class="footer__inner container">
    <div class="footer__brand">
      <a href="/" class="footer__logo">{SITE.title}</a>
      <p class="footer__tagline">{SITE.tagline}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer navigation">
      {FOOTER_LINKS.map((link) => (
        <a href={link.href} class="footer__link">{link.label}</a>
      ))}
    </nav>

    <div class="footer__social">
      <a href={SOCIAL.twitter} target="_blank" rel="noopener noreferrer" class="footer__link">Twitter/X</a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="footer__link">LinkedIn</a>
      <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="footer__link">GitHub</a>
    </div>

    <p class="footer__copy">&copy; {year} {SITE.author.name}</p>
  </div>
</footer>

<style is:global>
  .footer {
    position: relative;
    margin-top: var(--space-12);
    padding: var(--space-16) 0 var(--space-10);
    background-color: #f8fafc;
    background-image: linear-gradient(
      160deg,
      #f8fafc 0%,
      #f1f5f9 35%,
      #eef2ff 70%,
      #ecfeff 100%
    );
    color: var(--color-text);
    overflow: hidden;
    border-top: 1px solid var(--color-border);
  }

  .footer__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-image: linear-gradient(
      90deg,
      rgba(99, 102, 241, 0.35) 0%,
      rgba(139, 92, 246, 0.25) 50%,
      rgba(6, 182, 212, 0.35) 100%
    );
  }

  .footer__glow {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      ellipse 60% 70% at 80% 0%,
      rgba(99, 102, 241, 0.08),
      transparent 65%
    );
    pointer-events: none;
  }

  .footer__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-rows: auto auto;
    gap: var(--space-8) var(--space-12);
    align-items: start;
  }

  .footer__brand {
    grid-row: span 2;
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .footer__logo:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .footer__tagline {
    margin-top: var(--space-2);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer__nav,
  .footer__social {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .footer__copy {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  /* Dark theme — richer contrast footer */
  [data-theme='dark'] .footer {
    background-color: #060a14;
    background-image: linear-gradient(145deg, #060a14 0%, #1e1b4b 38%, #0e4f6e 100%);
    color: #f8fafc;
    border-top-color: rgba(255, 255, 255, 0.06);
  }

  [data-theme='dark'] .footer__bar {
    height: 3px;
    background-image: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #06b6d4 100%);
  }

  [data-theme='dark'] .footer__glow {
    background-image: radial-gradient(
      ellipse 65% 75% at 90% 10%,
      rgba(139, 92, 246, 0.28),
      transparent 55%
    );
  }

  [data-theme='dark'] .footer__logo {
    color: #f8fafc;
  }

  [data-theme='dark'] .footer__logo:hover {
    color: #67e8f9;
  }

  [data-theme='dark'] .footer__tagline {
    color: rgba(248, 250, 252, 0.5);
  }

  [data-theme='dark'] .footer__link {
    color: rgba(248, 250, 252, 0.72);
  }

  [data-theme='dark'] .footer__link:hover {
    color: #67e8f9;
  }

  [data-theme='dark'] .footer__copy {
    color: rgba(248, 250, 252, 0.5);
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 640px) {
    .footer {
      padding: var(--space-12) 0 var(--space-8);
    }

    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .footer__brand {
      grid-row: auto;
    }

    .footer__nav,
    .footer__social {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-4) var(--space-6);
    }
  }
</style>
