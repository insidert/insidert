---
import { getCollection } from 'astro:content';

const posts = await getCollection('notes');
const filteredPosts = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  tags: p.data.tags,
}));
---

<search-blog data-posts={JSON.stringify(filteredPosts)}>
  <label for="blog-search" class="sr-only">Search posts</label>
  <div class="search-blog__input-wrap">
    <svg class="search-blog__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.3-4.3"/>
    </svg>
    <input
      type="search"
      id="blog-search"
      class="input search-blog__input"
      placeholder="Search thoughts, experiments, and lessons..."
      autocomplete="off"
    />
  </div>
  <ul class="search-blog__results" id="search-results" role="listbox" hidden></ul>
</search-blog>

<style>
  search-blog {
    display: block;
    position: relative;
    margin-bottom: var(--space-8);
  }

  .search-blog__input-wrap {
    position: relative;
  }

  .search-blog__icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-blog__input {
    padding-left: calc(var(--space-4) + 28px);
  }

  .search-blog__results {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    list-style: none;
    margin: 0;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: 50;
    max-height: 400px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .search-blog__results[hidden] {
    display: none;
  }

  .search-blog__results li {
    padding: var(--space-4) var(--space-4);
    border-radius: var(--radius-md);
    transition: background var(--duration-normal);
  }

  .search-blog__results li + li {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-1);
    padding-top: calc(var(--space-4) + var(--space-1));
  }

  .search-blog__results li:hover {
    background: var(--color-surface-raised);
  }

  .search-blog__results a {
    display: block;
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text);
    text-decoration: none;
    line-height: var(--leading-snug);
  }

  .search-blog__results a:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .search-blog__results p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>

<script>
  import Fuse from 'fuse.js';

  class SearchBlog extends HTMLElement {
    connectedCallback() {
      const storeData = JSON.parse(this.dataset.posts ?? '[]');
      const input = this.querySelector('#blog-search') as HTMLInputElement;
      const results = this.querySelector('#search-results') as HTMLUListElement;

      const fuse = new Fuse(storeData, {
        threshold: 0.3,
        minMatchCharLength: 2,
        keys: ['title', 'description', 'tags'],
      });

      input?.addEventListener('input', () => {
        if (!input.value.trim()) {
          results.hidden = true;
          results.innerHTML = '';
          return;
        }

        const matches = fuse.search(input.value);

        if (matches.length === 0) {
          results.hidden = false;
          results.innerHTML = '<li><p class="search-blog__empty">Nothing matched — try a different keyword.</p></li>';
          return;
        }

        results.hidden = false;
        results.innerHTML = matches
          .slice(0, 8)
          .map(
            (r) => `
            <li role="option">
              <a href="/notes/${r.item.id}/">${r.item.title}</a>
              <p>${r.item.description}</p>
            </li>
          `,
          )
          .join('');
      });

      document.addEventListener('click', (e) => {
        if (!this.contains(e.target as Node)) {
          results.hidden = true;
        }
      });
    }
  }

  customElements.define('search-blog', SearchBlog);
</script>
