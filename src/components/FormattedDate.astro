---
interface Props {
  date: Date;
  uppercase?: boolean;
}

const { date, uppercase = false } = Astro.props;

const formatted = date.toLocaleDateString('en-us', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<time datetime={date.toISOString()}>
  {uppercase ? formatted.toUpperCase() : formatted}
</time>
