---
import { OBSESSIONS } from '../../lib/home';
import FadeIn from '../react/FadeIn';
import SectionWave from '../ui/SectionWave.astro';

const ORB_LAYOUT = [
  { top: '8%', left: '12%', size: 'lg', rotate: -4, delay: 0, duration: 7 },
  { top: '42%', left: '58%', size: 'md', rotate: 3, delay: 0.5, duration: 6 },
  { top: '18%', left: '72%', size: 'sm', rotate: -2, delay: 1, duration: 8 },
  { top: '62%', left: '22%', size: 'md', rotate: 5, delay: 0.3, duration: 6.5 },
  { top: '55%', left: '78%', size: 'lg', rotate: -3, delay: 0.8, duration: 7.5 },
] as const;

const THEME_VARS: Record<string, string> = {
  technology: 'var(--topic-technology)',
  entrepreneurship: 'var(--topic-entrepreneurship)',
  fitness: 'var(--topic-fitness)',
  product: 'var(--topic-product)',
  marketing: 'var(--topic-marketing)',
};

const SIZE_MAP = { sm: '4.5rem', md: '6rem', lg: '7.5rem' };
const FONT_MAP = { sm: 'var(--text-sm)', md: 'var(--text-base)', lg: 'var(--text-lg)' };
---

<section class="obsessions-zone section--lavender" id="obsessions">
  <div class="container">
    <FadeIn client:visible>
      <div class="obsessions-zone__header">
        <span class="scribble-label">On My Mind</span>
        <h2 class="zone-title">Current Obsessions</h2>
        <p class="obsessions-zone__desc">
          The ideas I keep circling back to — floating around until they become something real.
        </p>
      </div>
    </FadeIn>

    <FadeIn client:visible>
      <div class="obsession-cloud">
        {OBSESSIONS.map((item, i) => {
          const layout = ORB_LAYOUT[i];
          const color = THEME_VARS[item.theme] ?? 'var(--color-accent)';
          return (
            <a
              href={`/tags/${item.slug}`}
              class="obsession-orb"
              style={`
                top: ${layout.top};
                left: ${layout.left};
                width: ${SIZE_MAP[layout.size]};
                height: ${SIZE_MAP[layout.size]};
                font-size: ${FONT_MAP[layout.size]};
                --orb-color: ${color};
                --orb-bg: color-mix(in srgb, ${color} 12%, var(--color-bg));
                --orb-border: color-mix(in srgb, ${color} 30%, transparent);
                --orb-rotate: ${layout.rotate}deg;
                --drift-duration: ${layout.duration}s;
                --drift-delay: ${layout.delay}s;
              `}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    </FadeIn>
  </div>
</section>

<SectionWave fill="var(--color-bg-peach)" flip />

<style>
  .obsessions-zone {
    padding: var(--space-16) var(--space-6) var(--space-20);
    overflow: hidden;
  }

  .obsessions-zone__header {
    max-width: 28rem;
    margin-bottom: var(--space-8);
  }

  .obsessions-zone__desc {
    margin-top: var(--space-4);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 640px) {
    .obsession-cloud {
      min-height: 420px;
    }

    .obsession-orb {
      font-size: var(--text-sm) !important;
    }
  }
</style>
