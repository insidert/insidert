---
import HeroGradient from '../react/HeroGradient';
import { OBSESSIONS, WRITING_ABOUT } from '../../lib/home';
---

<section class="hero-workshop section--peach">
  <HeroGradient client:load />

  <div class="hero-workshop__inner container">
    <div class="hero-workshop__intro">
      <p class="hero-cli" role="status">
        <span class="hero-cli__prompt">$</span> connected to inside ravi teja.<span class="hero-cli__cursor" aria-hidden="true" />
      </p>
      <h1 class="hero-workshop__headline">
        Hey, I'm <span class="gradient-text">Ravi Teja</span>.
      </h1>
      <p class="hero-workshop__tagline">
        Coder. Entrepreneur. This is my digital space — wander around.
      </p>
      <span class="scribble-divider" aria-hidden="true" />
    </div>

    <div class="hero-workshop__dashboard">
      <div class="dash-panel dash-panel--thinking">
        <h2 class="dash-panel__heading">Thinking about</h2>
        <ul class="dash-panel__list">
          {OBSESSIONS.map((item) => (
            <li>
              <a href={`/tags/${item.slug}`} class="dash-panel__link">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="dash-panel dash-panel--writing">
        <h2 class="dash-panel__heading">Writing about</h2>
        <ul class="dash-panel__list">
          {WRITING_ABOUT.map((item) => (
            <li>
              <a href={item.href} class="dash-panel__link">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-workshop {
    position: relative;
    overflow: hidden;
    padding: var(--space-16) 0 var(--space-20);
  }

  .hero-workshop__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-12) var(--space-16);
    align-items: start;
  }

  .hero-cli {
    margin: 0 0 var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .hero-cli__prompt {
    color: var(--color-success);
    font-weight: 600;
    margin-right: var(--space-2);
  }

  .hero-cli__cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    background: var(--color-text-secondary);
    vertical-align: text-bottom;
    animation: hero-cli-blink 1.1s step-end infinite;
  }

  @keyframes hero-cli-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-workshop__headline {
    font-size: clamp(var(--text-4xl), 5.5vw, var(--text-6xl));
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-5);
    max-width: 14ch;
  }

  .hero-workshop__tagline {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 32rem;
  }

  .hero-workshop__dashboard {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .dash-panel--thinking {
    --panel-dot: var(--topic-technology);
    transform: rotate(-0.5deg);
  }

  .dash-panel--writing {
    --panel-dot: var(--topic-marketing);
    transform: rotate(0.8deg);
  }

  @media (max-width: 900px) {
    .hero-workshop__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .hero-workshop__dashboard {
      grid-template-columns: 1fr;
    }

    .dash-panel--thinking,
    .dash-panel--writing {
      transform: none;
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .hero-workshop {
      padding: var(--space-12) 0 var(--space-16);
    }

    .hero-workshop__headline {
      max-width: none;
    }

    .hero-workshop__tagline {
      font-size: var(--text-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cli__cursor {
      animation: none;
    }
  }
</style>
