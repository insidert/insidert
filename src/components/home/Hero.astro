---
import type { CollectionEntry } from 'astro:content';
import HeroGradient from '../react/HeroGradient';
import HeroMindMap from '../react/HeroMindMap';
import { PROJECTS } from '../../consts';
import { HERO_MIND_NODES, HERO_FLOATING_WORDS, HERO_MICROCOPY } from '../../lib/home';
import '../../styles/hero.css';

interface Props {
  latestPost?: CollectionEntry<'blog'> | null;
}

const { latestPost } = Astro.props;
const primaryProject = PROJECTS[0];
---

<section class="hero-inside">
  <HeroGradient client:load />

  <div class="hero-inside__inner">
    <div class="hero-inside__micro container">
      <span class="hero-inside__micro-item">
        <strong>Status:</strong> {HERO_MICROCOPY.status}
      </span>
      <span class="hero-inside__micro-item">
        <strong>Mood:</strong> {HERO_MICROCOPY.mood}
      </span>
      <span class="hero-inside__micro-item">
        <strong>Experiment:</strong> {HERO_MICROCOPY.experiment}
      </span>
    </div>

    <HeroMindMap
      nodes={HERO_MIND_NODES}
      words={HERO_FLOATING_WORDS}
      client:load
    />

    <div class="hero-inside__desk">
      <a
        href={primaryProject.url}
        class="hero-inside__card"
        target={primaryProject.url.startsWith('http') ? '_blank' : undefined}
        rel={primaryProject.url.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        <span class="hero-inside__card-label">Currently Building</span>
        <span class="hero-inside__card-value hero-inside__card-value--accent">{primaryProject.name}</span>
        <p class="hero-inside__card-desc">{primaryProject.description}</p>
      </a>

      <a href="/tags/ai" class="hero-inside__card hero-inside__card--tilt">
        <span class="hero-inside__card-label">Currently Exploring</span>
        <span class="hero-inside__card-value">AI Workflows</span>
        <p class="hero-inside__card-desc">How AI changes the builder's daily rhythm.</p>
      </a>

      {latestPost && (
        <a href={`/blog/${latestPost.id}/`} class="hero-inside__card">
          <span class="hero-inside__card-label">Recently Published</span>
          <span class="hero-inside__card-value">{latestPost.data.title}</span>
        </a>
      )}

      <a href="/tags/opinions" class="hero-inside__card hero-inside__card--tilt">
        <span class="hero-inside__card-label">Current Obsession</span>
        <span class="hero-inside__card-value">Growth Systems</span>
        <p class="hero-inside__card-desc">Building things that compound over time.</p>
      </a>
    </div>
  </div>
</section>
