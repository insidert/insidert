---
import type { CollectionEntry } from 'astro:content';
import FadeIn from '../react/FadeIn';
import PostFeed from '../editorial/PostFeed.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section class="featured-posts" id="posts">
  <div class="container container--wide">
    <FadeIn client:visible>
      <div class="section-header">
        <span class="section-label">Latest Writing</span>
        <h2 class="section-title">Featured Posts</h2>
        <p class="section-subtitle">
          Thoughts on building products, running businesses, and lessons from the journey.
        </p>
      </div>
    </FadeIn>

    <FadeIn client:visible>
      <PostFeed posts={posts} />
    </FadeIn>

    <FadeIn client:visible>
      <div class="featured-posts__cta">
        <a href="/blog" class="link-underline">View all posts →</a>
      </div>
    </FadeIn>
  </div>
</section>

<style>
  .featured-posts {
    padding: var(--space-10) var(--space-6) var(--space-16);
  }

  .featured-posts .section-header {
    margin-bottom: var(--space-8);
  }

  .featured-posts__cta {
    margin-top: var(--space-8);
    text-align: center;
  }

  @media (max-width: 640px) {
    .featured-posts {
      padding: var(--space-8) var(--space-4) var(--space-12);
    }
  }
</style>
