---
import FadeIn from '../react/FadeIn';
import MagneticButton from '../react/MagneticButton';
---

<section class="newsletter section">
  <div class="container">
    <FadeIn client:visible>
      <div class="newsletter__card">
        <div class="newsletter__glow" aria-hidden="true" />
        <div class="newsletter__content">
          <h2 class="newsletter__title">Join the journey.</h2>
          <p class="newsletter__desc">
            Occasional thoughts on startups, technology and building things.
          </p>
          <form class="newsletter__form" action="#" method="post">
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="newsletter-email"
              name="email"
              class="input newsletter__input"
              placeholder="you@example.com"
              required
              autocomplete="email"
            />
            <MagneticButton type="submit" className="btn btn--primary newsletter__btn" client:visible>
              Subscribe
            </MagneticButton>
          </form>
        </div>
      </div>
    </FadeIn>
  </div>
</section>

<style>
  .newsletter__card {
    position: relative;
    padding: var(--space-16) var(--space-12);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    text-align: center;
  }

  .newsletter__glow {
    position: absolute;
    inset: 0;
    background: var(--gradient-newsletter);
    pointer-events: none;
  }

  .newsletter__content {
    position: relative;
    z-index: 1;
    max-width: 32rem;
    margin: 0 auto;
  }

  .newsletter__title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .newsletter__desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    line-height: var(--leading-relaxed);
  }

  .newsletter__form {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .newsletter__input {
    flex: 1;
    min-width: 200px;
  }

  .newsletter__btn {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .newsletter__card {
      padding: var(--space-10) var(--space-6);
    }

    .newsletter__form {
      flex-direction: column;
    }
  }
</style>
