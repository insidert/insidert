---
import FadeIn from '../react/FadeIn';
import MagneticButton from '../react/MagneticButton';
---

<section class="newsletter-zone section--cream">
  <div class="container">
    <FadeIn client:visible>
      <div class="newsletter-zone__card">
        <div class="newsletter-zone__tape" aria-hidden="true" />
        <div class="newsletter-zone__content">
          <span class="scribble-label">Stay in the loop</span>
          <h2 class="newsletter-zone__title">Drop your email. I'll send notes.</h2>
          <p class="newsletter-zone__desc">
            Occasional thoughts on startups, building products, and whatever I'm obsessing over this week.
          </p>
          <form class="newsletter-zone__form" action="#" method="post">
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="newsletter-email"
              name="email"
              class="input newsletter-zone__input"
              placeholder="you@example.com"
              required
              autocomplete="email"
            />
            <MagneticButton type="submit" className="btn btn--primary newsletter-zone__btn" client:visible>
              Subscribe
            </MagneticButton>
          </form>
        </div>
      </div>
    </FadeIn>
  </div>
</section>

<style>
  .newsletter-zone {
    padding: var(--space-12) var(--space-6) var(--space-20);
  }

  .newsletter-zone__card {
    position: relative;
    max-width: 36rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-10);
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
    border-radius: var(--radius-sm);
    box-shadow:
      3px 4px 16px rgba(28, 25, 23, 0.08),
      0 1px 3px rgba(28, 25, 23, 0.04);
    transform: rotate(-0.6deg);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .newsletter-zone__card:hover {
    transform: rotate(0deg) translateY(-2px);
  }

  .newsletter-zone__tape {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%) rotate(1deg);
    width: 80px;
    height: 22px;
    background: color-mix(in srgb, var(--color-secondary) 35%, transparent);
    border-radius: 1px;
    opacity: 0.6;
  }

  .newsletter-zone__content {
    text-align: center;
  }

  .newsletter-zone__title {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: var(--space-2) 0 var(--space-4);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .newsletter-zone__desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    line-height: var(--leading-relaxed);
  }

  .newsletter-zone__form {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .newsletter-zone__input {
    flex: 1;
    min-width: 200px;
    max-width: 280px;
  }

  .newsletter-zone__btn {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .newsletter-zone__card {
      padding: var(--space-10) var(--space-6);
    }

    .newsletter-zone__form {
      flex-direction: column;
      align-items: stretch;
    }

    .newsletter-zone__input {
      max-width: none;
    }
  }
</style>
