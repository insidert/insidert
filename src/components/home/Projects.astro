---
import { PROJECTS } from '../../consts';
import { PROJECT_LAYOUT } from '../../lib/home';
import FadeIn from '../react/FadeIn';

const cardGradients = [
  'linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%)',
  'linear-gradient(135deg, #FFB347 0%, #FF6B6B 100%)',
  'linear-gradient(135deg, #F472B6 0%, #A855F7 100%)',
  'linear-gradient(135deg, #14B8A6 0%, #2DD4BF 100%)',
  'linear-gradient(135deg, #A855F7 0%, #F472B6 100%)',
];
---

<section class="workbench-zone" id="projects">
  <div class="container">
    <FadeIn client:visible>
      <div class="workbench-zone__header">
        <span class="scribble-label">The Workbench</span>
        <h2 class="zone-title">What I'm Building</h2>
        <p class="workbench-zone__desc">
          Projects scattered across the desk.
        </p>
      </div>
    </FadeIn>
  </div>

  <div class="workbench">
    <svg class="workbench__connector" aria-hidden="true" viewBox="0 0 1200 40" preserveAspectRatio="none">
      <path
        d="M0,20 Q200,5 400,20 T800,18 T1200,22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-dasharray="6 8"
        opacity="0.25"
      />
    </svg>

    <div class="workbench__track">
      {PROJECTS.map((project, i) => {
        const layout = PROJECT_LAYOUT[i] ?? PROJECT_LAYOUT[0];
        return (
          <FadeIn delay={i * 0.06} client:visible>
            <a
              href={project.url}
              class:list={[
                'workbench__card',
                layout.wide ? 'workbench__card--wide' : 'workbench__card--narrow',
              ]}
              style={`transform: rotate(${layout.rotate}deg) translateY(${layout.offset}px);`}
              target={project.url.startsWith('http') ? '_blank' : undefined}
              rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <article class="workbench-card">
                <div
                  class="workbench-card__icon"
                  style={`background: ${cardGradients[i % cardGradients.length]}`}
                  aria-hidden="true"
                >
                  {project.name.charAt(0)}
                </div>
                <div class="workbench-card__body">
                  <div class="workbench-card__top">
                    <h3 class="workbench-card__name">{project.name}</h3>
                    <span class:list={['badge', project.status === 'Active' ? 'badge--active' : 'badge--building']}>
                      {project.status}
                    </span>
                  </div>
                  <p class="workbench-card__desc">{project.description}</p>
                </div>
              </article>
            </a>
          </FadeIn>
        );
      })}
    </div>
  </div>
</section>

<style>
  .workbench-zone {
    padding: var(--space-16) 0 var(--space-8);
    background: var(--color-bg-cream);
    overflow: hidden;
  }

  .workbench-zone__header {
    max-width: 36rem;
    margin: 0 auto var(--space-6);
    text-align: center;
  }

  .workbench-zone__desc {
    margin-top: var(--space-4);
    margin-inline: auto;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .workbench__connector {
    display: block;
    width: 100%;
    height: 24px;
    color: var(--color-accent);
    margin-bottom: calc(var(--space-2) * -1);
  }

  .workbench-card {
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    min-height: 200px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .workbench-card__icon {
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: white;
    border-radius: var(--radius-lg);
    transform: rotate(-3deg);
  }

  .workbench-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .workbench-card__name {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .workbench-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 640px) {
    .workbench-zone {
      padding: var(--space-12) 0 var(--space-6);
    }

    .workbench__connector {
      display: none;
    }

    .workbench-card {
      min-height: auto;
    }
  }
</style>
