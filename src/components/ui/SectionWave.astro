---
interface Props {
  fill?: string;
  flip?: boolean;
}

const { fill = 'var(--color-bg-cream)', flip = false } = Astro.props;
---

<div class:list={['section-wave', { 'section-wave--flip': flip }]} aria-hidden="true">
  <svg viewBox="0 0 1440 56" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M0,32 C240,56 480,8 720,28 C960,48 1200,16 1440,36 L1440,56 L0,56 Z"
      fill={fill}
    />
  </svg>
</div>

<style>
  .section-wave {
    line-height: 0;
    margin-top: -1px;
  }

  .section-wave svg {
    display: block;
    width: 100%;
    height: 2.5rem;
  }

  .section-wave--flip {
    transform: scaleY(-1);
  }
</style>
