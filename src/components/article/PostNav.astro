---
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../../lib/posts';
import { getTagTheme } from '../../lib/topics';

interface Props {
  prev: CollectionEntry<'notes'> | null;
  next: CollectionEntry<'notes'> | null;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="post-nav" aria-label="Post navigation">
    <p class="post-nav__heading">
      <span class="scribble-label">Keep exploring</span>
    </p>
    <div class="post-nav__grid">
      {prev && (
        <a
          href={`/notes/${prev.id}/`}
          class="post-nav__card post-nav__card--prev"
          style={`--nav-accent: ${getTagTheme(prev.data.tags[0]).color}`}
        >
          <span class="post-nav__direction">← Previous note</span>
          <span class="post-nav__category">{getCategory(prev)}</span>
          <span class="post-nav__title">{prev.data.title}</span>
          {prev.data.description && (
            <span class="post-nav__excerpt">{prev.data.description}</span>
          )}
        </a>
      )}
      {next && (
        <a
          href={`/notes/${next.id}/`}
          class="post-nav__card post-nav__card--next"
          style={`--nav-accent: ${getTagTheme(next.data.tags[0]).color}`}
        >
          <span class="post-nav__direction">Next note →</span>
          <span class="post-nav__category">{getCategory(next)}</span>
          <span class="post-nav__title">{next.data.title}</span>
          {next.data.description && (
            <span class="post-nav__excerpt">{next.data.description}</span>
          )}
        </a>
      )}
    </div>
  </nav>
)}

<style>
  .post-nav {
    margin-top: var(--space-4);
  }

  .post-nav__heading {
    margin: 0 0 var(--space-6);
  }

  .post-nav__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .post-nav__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    background: var(--color-bg-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out),
      border-color var(--duration-slow) var(--ease-out);
  }

  .post-nav__card--prev {
    transform: rotate(-0.6deg);
  }

  .post-nav__card--next {
    transform: rotate(0.5deg);
    text-align: right;
    align-items: flex-end;
  }

  .post-nav__card:hover {
    text-decoration: none;
    transform: rotate(0deg) translateY(-3px);
    border-color: color-mix(in srgb, var(--nav-accent) 35%, var(--color-border));
    box-shadow: 0 8px 28px color-mix(in srgb, var(--nav-accent) 12%, transparent);
  }

  .post-nav__direction {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .post-nav__category {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--nav-accent);
  }

  .post-nav__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--color-text);
    transition: color var(--duration-normal) var(--ease-out);
  }

  .post-nav__card:hover .post-nav__title {
    color: var(--nav-accent);
  }

  .post-nav__excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .post-nav__grid {
      grid-template-columns: 1fr;
    }

    .post-nav__card--prev,
    .post-nav__card--next {
      transform: none;
    }

    .post-nav__card--next {
      text-align: left;
      align-items: flex-start;
    }

    .post-nav__card:hover {
      transform: translateY(-3px);
    }
  }
</style>
