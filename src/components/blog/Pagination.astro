---
interface Props {
  currentPage: number;
  lastPage: number;
  baseUrl?: string;
}

const { currentPage, lastPage, baseUrl = '/blog' } = Astro.props;

function pageUrl(page: number) {
  return page === 1 ? baseUrl : `${baseUrl}/page/${page}`;
}
---

{lastPage > 1 && (
  <nav class="pagination" aria-label="Blog pagination">
    {currentPage > 1 ? (
      <a href={pageUrl(currentPage - 1)} class="pagination__btn" aria-label="Previous page">
        ← Prev
      </a>
    ) : (
      <span class="pagination__btn pagination__btn--disabled" aria-hidden="true">← Prev</span>
    )}

    <div class="pagination__pages">
      {Array.from({ length: lastPage }, (_, i) => i + 1).map((page) => (
        <a
          href={pageUrl(page)}
          class:list={['pagination__page', { 'pagination__page--active': page === currentPage }]}
          aria-current={page === currentPage ? 'page' : undefined}
        >
          {page}
        </a>
      ))}
    </div>

    {currentPage < lastPage ? (
      <a href={pageUrl(currentPage + 1)} class="pagination__btn" aria-label="Next page">
        Next →
      </a>
    ) : (
      <span class="pagination__btn pagination__btn--disabled" aria-hidden="true">Next →</span>
    )}
  </nav>
)}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .pagination__btn {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-normal) var(--ease-out), color var(--duration-normal);
  }

  .pagination__btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-hover);
    text-decoration: none;
  }

  .pagination__btn--disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  .pagination__pages {
    display: flex;
    gap: var(--space-1);
  }

  .pagination__page {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background var(--duration-normal), color var(--duration-normal);
  }

  .pagination__page:hover {
    color: var(--color-text);
    background: var(--color-surface);
    text-decoration: none;
  }

  .pagination__page--active {
    color: var(--color-text);
    background: var(--color-accent-muted);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .pagination__pages {
      display: none;
    }
  }
</style>
