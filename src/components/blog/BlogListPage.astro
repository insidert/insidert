---
import type { CollectionEntry } from 'astro:content';
import PostMasonry from '../editorial/PostMasonry.astro';
import BlogFilters from './BlogFilters.astro';
import Pagination from './Pagination.astro';
import FadeIn from '../react/FadeIn';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  lastPage: number;
  tags: string[];
}

const { posts, currentPage, lastPage, tags } = Astro.props;
---

<section class="blog-hero section section--peach">
  <div class="container container--wide">
    <FadeIn client:visible>
      <div class="blog-hero__header">
        <span class="scribble-label">The Notebook</span>
        <h1 class="blog-hero__title">All Notes</h1>
        <p class="blog-hero__desc">
          A growing collection of experiments, guides, and lessons — browse by topic.
        </p>
      </div>
    </FadeIn>

    <BlogFilters tags={tags.slice(0, 8)} />
  </div>
</section>

<section class="section blog-content section--cream">
  <div class="container container--wide">
    <FadeIn client:visible>
      <PostMasonry posts={posts} />
    </FadeIn>

    <Pagination currentPage={currentPage} lastPage={lastPage} />
  </div>
</section>

<style>
  .blog-hero {
    padding-bottom: 0;
  }

  .blog-hero__header {
    margin-bottom: var(--space-8);
    max-width: 36rem;
  }

  .blog-hero__title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
    font-weight: 700;
    margin: var(--space-3) 0 var(--space-4);
  }

  .blog-hero__desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .blog-content {
    padding-top: var(--space-2);
  }
</style>
