---
import type { CollectionEntry } from 'astro:content';
import type { NoteVariant } from '../../lib/posts';
import FormattedDate from '../FormattedDate.astro';
import { getCategory } from '../../lib/posts';
import { getTagTheme } from '../../lib/topics';

interface Props {
  post: CollectionEntry<'blog'>;
  variant: NoteVariant;
  index?: number;
}

const { post, variant, index = 0 } = Astro.props;
const tag = post.data.tags[0];
const theme = getTagTheme(tag);
const category = getCategory(post);
const href = `/blog/${post.id}/`;
const noteRotations = [-1.8, 1.2, -0.6, 2.1, -1.4, 0.9];
const rotation = noteRotations[index % noteRotations.length];
---

{variant === 'hero' && (
  <a href={href} class="note-card note-card--hero" style={`--note-accent: ${theme.color}`}>
    <span class="note-card__label">{category}</span>
    <h3 class="note-card__title">{post.data.title}</h3>
    {post.data.description && (
      <p class="note-card__excerpt">{post.data.description}</p>
    )}
    <span class="note-card__meta">
      <FormattedDate date={post.data.updatedDate} />
    </span>
  </a>
)}

{variant === 'note' && (
  <a
    href={href}
    class="note-card note-card--sticky"
    style={`--note-accent: ${theme.color}; transform: rotate(${rotation}deg)`}
  >
    <span class="note-card__tape" aria-hidden="true" />
    <span class="note-card__label note-card__label--small">{category}</span>
    <h3 class="note-card__title note-card__title--small">{post.data.title}</h3>
    <span class="note-card__date">
      <FormattedDate date={post.data.updatedDate} />
    </span>
  </a>
)}

{variant === 'snippet' && (
  <a href={href} class="note-card note-card--snippet" style={`--note-accent: ${theme.color}`}>
    <div class="note-card__snippet-header">
      <span class="note-card__label">{category}</span>
      <span class="note-card__dot" aria-hidden="true">·</span>
      <FormattedDate date={post.data.updatedDate} />
    </div>
    <h3 class="note-card__title note-card__title--snippet">{post.data.title}</h3>
    {post.data.description && (
      <p class="note-card__snippet-body">{post.data.description}</p>
    )}
  </a>
)}

{variant === 'quote' && (
  <a href={href} class="note-card note-card--quote" style={`--note-accent: ${theme.color}`}>
    <span class="note-card__quote-mark" aria-hidden="true">"</span>
    <p class="note-card__quote-text">
      {post.data.description ?? post.data.title}
    </p>
    <cite class="note-card__quote-cite">{post.data.title}</cite>
  </a>
)}

{variant === 'timeline' && (
  <a href={href} class="note-card note-card--timeline" style={`--note-accent: ${theme.color}`}>
    <div class="note-card__timeline-dot" aria-hidden="true" />
    <div class="note-card__timeline-body">
      <time class="note-card__timeline-date">
        <FormattedDate date={post.data.updatedDate} />
      </time>
      <h3 class="note-card__title note-card__title--timeline">{post.data.title}</h3>
    </div>
  </a>
)}

<style>
  .note-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out);
  }

  .note-card:hover {
    text-decoration: none;
  }

  /* Hero — large feature */
  .note-card--hero {
    padding: var(--space-10) var(--space-8);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--note-accent) 8%, var(--color-bg)) 0%,
      color-mix(in srgb, var(--color-highlight) 5%, var(--color-bg)) 100%
    );
    border: 1px solid color-mix(in srgb, var(--note-accent) 20%, var(--color-border));
    border-radius: var(--radius-2xl);
    min-height: 280px;
    position: relative;
    overflow: hidden;
  }

  .note-card--hero::after {
    content: '';
    position: absolute;
    bottom: -40px;
    right: -40px;
    width: 160px;
    height: 160px;
    background: var(--note-accent);
    opacity: 0.08;
    border-radius: 50%;
  }

  .note-card--hero:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px color-mix(in srgb, var(--note-accent) 18%, transparent);
  }

  .note-card--hero .note-card__title {
    font-size: clamp(var(--text-2xl), 3.5vw, var(--text-4xl));
    max-width: 90%;
  }

  .note-card--hero .note-card__excerpt {
    font-size: var(--text-lg);
    max-width: 36rem;
    margin-top: var(--space-4);
  }

  /* Sticky note */
  .note-card--sticky {
    position: relative;
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--note-accent) 8%, var(--color-bg)) 0%,
      color-mix(in srgb, var(--note-accent) 14%, var(--color-surface)) 100%
    );
    border: 1px solid color-mix(in srgb, var(--color-secondary) 30%, transparent);
    border-radius: var(--radius-sm);
    box-shadow: 2px 4px 12px rgba(28, 25, 23, 0.08);
    min-height: 160px;
  }

  .note-card--sticky:hover {
    transform: rotate(0deg) translateY(-4px) scale(1.02) !important;
    box-shadow: 4px 8px 24px rgba(28, 25, 23, 0.12);
  }

  .note-card--sticky .note-card__title {
    color: #1c1917;
  }

  .note-card--sticky .note-card__date {
    color: #57534e;
  }

  .note-card__tape {
    position: absolute;
    top: -7px;
    left: 50%;
    transform: translateX(-50%);
    width: 52px;
    height: 16px;
    background: color-mix(in srgb, var(--color-text-muted) 20%, transparent);
    border-radius: 1px;
  }

  /* Newspaper snippet */
  .note-card--snippet {
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg);
    border: 1px dashed color-mix(in srgb, var(--note-accent) 35%, var(--color-border));
    border-radius: var(--radius-md);
  }

  .note-card--snippet:hover {
    border-style: solid;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .note-card__snippet-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-3);
  }

  .note-card__snippet-body {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .note-card__title--snippet {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-3);
  }

  /* Quote preview */
  .note-card--quote {
    padding: var(--space-8) var(--space-6);
    background: var(--color-bg-rose);
    border-radius: var(--radius-xl);
    border-left: 3px solid var(--note-accent);
    position: relative;
  }

  .note-card--quote:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }

  .note-card__quote-mark {
    position: absolute;
    top: var(--space-4);
    left: var(--space-5);
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 1;
    color: var(--note-accent);
    opacity: 0.2;
    pointer-events: none;
  }

  .note-card__quote-text {
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin: 0;
    padding-top: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .note-card__quote-cite {
    display: block;
    margin-top: var(--space-4);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    font-style: normal;
    font-weight: 500;
    color: var(--note-accent);
  }

  /* Timeline entry */
  .note-card--timeline {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .note-card--timeline:hover .note-card__title--timeline {
    color: var(--note-accent);
  }

  .note-card__timeline-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--note-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--note-accent) 20%, transparent);
  }

  .note-card__timeline-date {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .note-card__title--timeline {
    font-size: var(--text-base);
    margin-top: var(--space-1);
    transition: color var(--duration-normal) var(--ease-out);
  }

  /* Shared */
  .note-card__label {
    display: inline-block;
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--note-accent);
    margin-bottom: var(--space-3);
  }

  .note-card__label--small {
    margin-bottom: var(--space-2);
  }

  .note-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .note-card__title--small {
    font-size: var(--text-base);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .note-card__excerpt {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .note-card__meta {
    display: block;
    margin-top: var(--space-6);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .note-card__date {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  :global([data-theme='dark']) .note-card--sticky {
    background: linear-gradient(160deg, #3a3020 0%, #2a2218 100%);
    border-color: color-mix(in srgb, var(--color-secondary) 35%, transparent);
    box-shadow: 2px 4px 12px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme='dark']) .note-card--sticky:hover {
    box-shadow: 4px 8px 24px rgba(0, 0, 0, 0.45);
  }

  :global([data-theme='dark']) .note-card--sticky .note-card__title {
    color: #fef3c7;
  }

  :global([data-theme='dark']) .note-card--sticky .note-card__date {
    color: #a8a29e;
  }
</style>
