---
import type { CollectionEntry } from 'astro:content';
import PostMeta from './PostMeta.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="post-item">
  <a href={`/blog/${post.id}/`} class="post-item__link">
    <PostMeta post={post} />
    <h3 class="post-item__title">{post.data.title}</h3>
    {post.data.description && (
      <p class="post-item__excerpt">{post.data.description}</p>
    )}
  </a>
</article>

<style>
  .post-item {
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }

  .post-item__link {
    position: relative;
    display: block;
    padding: var(--space-6) 0 var(--space-6) var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .post-item__link::before {
    content: '';
    position: absolute;
    left: 0;
    top: var(--space-6);
    bottom: var(--space-6);
    width: 2px;
    background: var(--color-accent);
    border-radius: 1px;
    transform: scaleY(0);
    transform-origin: center top;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .post-item__link:hover {
    text-decoration: none;
    transform: translateX(3px);
  }

  .post-item__link:hover::before {
    transform: scaleY(1);
  }

  .post-item__link :global(.post-meta) {
    margin-bottom: var(--space-2);
  }

  .post-item__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
    transition: color var(--duration-normal) var(--ease-out);
  }

  .post-item__link:hover .post-item__title {
    color: var(--color-accent);
  }

  .post-item__excerpt {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .post-item__link {
      padding: var(--space-5) 0 var(--space-5) var(--space-3);
    }

    .post-item__link::before {
      top: var(--space-5);
      bottom: var(--space-5);
    }

    .post-item__title {
      font-size: 1.125rem;
    }

    .post-item__excerpt {
      font-size: var(--text-sm);
      -webkit-line-clamp: 3;
    }
  }
</style>
