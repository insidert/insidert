---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import { getCategory } from '../../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const category = getCategory(post).toUpperCase();
---

<p class="post-meta">
  <span class="post-meta__category">{category}</span>
  <span class="post-meta__sep" aria-hidden="true">·</span>
  <FormattedDate date={post.data.updatedDate} uppercase />
</p>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    margin: 0;
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .post-meta__category {
    color: var(--color-accent);
  }

  .post-meta__sep {
    opacity: 0.45;
    user-select: none;
  }
</style>
