---
import AppLayout from '../layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';
import { getFeaturedPosts } from '../lib/posts';
import Hero from '../components/home/Hero.astro';
import FeaturedPosts from '../components/home/FeaturedPosts.astro';
import Projects from '../components/home/Projects.astro';
import Topics from '../components/home/Topics.astro';
import Newsletter from '../components/home/Newsletter.astro';

const posts = await getCollection('blog');
const featuredPosts = getFeaturedPosts(posts);
---

<AppLayout
  title={`${SITE.author.shortName} — ${SITE.tagline}`}
  description={SITE.description}
  fullWidth
>
  <Hero />
  {featuredPosts.length > 0 && <FeaturedPosts posts={featuredPosts} />}
  <Projects />
  <Topics />
  <Newsletter />
</AppLayout>
