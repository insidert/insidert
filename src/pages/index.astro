---
import AppLayout from '../layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';
import { getRecentNotes } from '../lib/posts';
import Hero from '../components/home/Hero.astro';
import Projects from '../components/home/Projects.astro';
import RecentNotes from '../components/home/RecentNotes.astro';
import ThingsLearned from '../components/home/ThingsLearned.astro';

const posts = await getCollection('blog');
const recentNotes = getRecentNotes(posts, 6);
---

<AppLayout
  title={`${SITE.author.shortName} — ${SITE.tagline}`}
  description={SITE.description}
  fullWidth
>
  <Hero />
  <Projects />
  {recentNotes.length > 0 && <RecentNotes posts={recentNotes} />}
  <ThingsLearned />
</AppLayout>
