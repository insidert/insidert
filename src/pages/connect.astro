---
import AppLayout from '../layouts/AppLayout.astro';
import { SITE, PROJECTS, SOCIAL } from '../consts';
import { OBSESSIONS, RAVI_NOTES } from '../lib/home';
import FadeIn from '../components/react/FadeIn';
import ContactForm from '../components/react/ContactForm';
---

<AppLayout
  title="Start a Conversation"
  description="Get in touch with Ravi Teja — builder, entrepreneur, and writer."
  fullWidth
>
  <section class="connect-page section--peach">
    <div class="container">
      <div class="connect-page__grid">
        <FadeIn client:visible>
          <div class="connect-page__intro">
            <span class="scribble-label">Say hello</span>
            <h1 class="zone-title">What's on your mind?</h1>
            <p class="connect-page__lead">
              Whether you're building a startup, exploring an idea, or just want to say hello — I'd love to hear from you.
            </p>

            <span class="scribble-divider" aria-hidden="true" />

            <div class="connect-page__panel">
              <h2 class="connect-page__panel-title">Currently thinking about</h2>
              <ul class="connect-page__list">
                {OBSESSIONS.map((item) => (
                  <li><a href={`/tags/${item.slug}`} class="connect-page__chip">{item.label}</a></li>
                ))}
              </ul>
            </div>

            <div class="connect-page__panel">
              <h2 class="connect-page__panel-title">Currently building</h2>
              <ul class="connect-page__list">
                {PROJECTS.slice(0, 4).map((p) => (
                  <li><span class="connect-page__chip connect-page__chip--muted">{p.name}</span></li>
                ))}
              </ul>
            </div>

            <div class="connect-page__panel connect-page__panel--note">
              <p class="connect-page__note">
                <span aria-hidden="true">✎</span>
                {RAVI_NOTES[0]}
              </p>
            </div>

            <div class="connect-page__social">
              <p class="connect-page__social-label">Or find me elsewhere</p>
              <div class="connect-page__social-links">
                <a href={SOCIAL.twitter} target="_blank" rel="noopener noreferrer">Twitter/X</a>
                <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">GitHub</a>
              </div>
            </div>
          </div>
        </FadeIn>

        <FadeIn delay={0.1} client:visible>
          <div class="connect-page__form-wrap">
            <div class="connect-page__form-card">
              <div class="connect-page__form-tape" aria-hidden="true" />
              <h2 class="connect-page__form-title">Send me a note</h2>
              <p class="connect-page__form-desc">No corporate inbox. Just a direct line to {SITE.author.shortName}.</p>
              <ContactForm client:load />
            </div>
          </div>
        </FadeIn>
      </div>
    </div>
  </section>
</AppLayout>

<style>
  .connect-page {
    padding: var(--space-16) 0 var(--space-20);
  }

  .connect-page__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12) var(--space-16);
    align-items: start;
  }

  .connect-page__lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 28rem;
  }

  .connect-page__panel {
    margin-top: var(--space-8);
  }

  .connect-page__panel-title {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .connect-page__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .connect-page__chip {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-muted);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  a.connect-page__chip:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .connect-page__chip--muted {
    color: var(--color-text-secondary);
    background: var(--color-surface-raised);
  }

  .connect-page__panel--note {
    margin-top: var(--space-6);
  }

  .connect-page__note {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-secondary);
    background: linear-gradient(160deg, #fffbeb 0%, #fef9c3 100%);
    border: 1px solid color-mix(in srgb, var(--color-secondary) 30%, transparent);
    border-radius: var(--radius-sm);
    transform: rotate(-1deg);
    line-height: var(--leading-relaxed);
  }

  .connect-page__social {
    margin-top: var(--space-10);
  }

  .connect-page__social-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .connect-page__social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .connect-page__social-links a {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .connect-page__social-links a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .connect-page__form-wrap {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
  }

  .connect-page__form-card {
    position: relative;
    padding: var(--space-10) var(--space-8);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    transform: rotate(0.5deg);
  }

  .connect-page__form-tape {
    position: absolute;
    top: -10px;
    right: var(--space-8);
    width: 64px;
    height: 20px;
    background: color-mix(in srgb, var(--color-highlight) 30%, transparent);
    border-radius: 1px;
    transform: rotate(2deg);
    opacity: 0.7;
  }

  .connect-page__form-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .connect-page__form-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    line-height: var(--leading-relaxed);
  }

  /* Contact form (React) */
  :global(.contact-form) {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  :global(.contact-field) {
    position: relative;
  }

  :global(.contact-field__label) {
    display: block;
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
    transition: color var(--duration-normal) var(--ease-out);
  }

  :global(.contact-field--focused .contact-field__label) {
    color: var(--color-accent);
  }

  :global(.contact-field__input) {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    outline: none;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }

  :global(.contact-field__textarea) {
    resize: vertical;
    min-height: 120px;
    line-height: var(--leading-relaxed);
  }

  :global(.contact-field--focused .contact-field__input) {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-muted);
    background: var(--color-bg);
  }

  :global(.contact-field--error .contact-field__input) {
    border-color: var(--color-accent);
  }

  :global(.contact-field__error) {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-style: italic;
  }

  :global(.contact-form__submit) {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  :global(.contact-form--success) {
    text-align: center;
    padding: var(--space-10) var(--space-6);
  }

  :global(.contact-form__success-icon) {
    display: block;
    font-size: var(--text-4xl);
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  :global(.contact-form__success-title) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  :global(.contact-form__success-text) {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 900px) {
    .connect-page__grid {
      grid-template-columns: 1fr;
    }

    .connect-page__form-wrap {
      position: static;
    }

    .connect-page__form-card {
      transform: none;
    }
  }
</style>
