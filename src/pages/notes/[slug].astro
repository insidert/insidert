---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import ArticleHeader from '../../components/article/ArticleHeader.astro';
import PostNav from '../../components/article/PostNav.astro';
import PostFeedbackForm from '../../components/article/PostFeedbackForm.astro';
import RelatedPosts from '../../components/article/RelatedPosts.astro';
import ReadingProgress from '../../components/react/ReadingProgress';
import { SITE } from '../../consts';
import { getCategory, getAdjacentPosts, getRelatedPosts, normalizeTagSlug } from '../../lib/posts';
import { getTagTheme } from '../../lib/topics';
import '../../styles/article.css';

export async function getStaticPaths() {
  const posts = await getCollection('notes');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'notes'>;

const post = Astro.props;
const allPosts = await getCollection('notes');
const { Content } = await render(post);

const category = getCategory(post);
const categoryTheme = getTagTheme(post.data.tags[0]);
const { prev, next } = getAdjacentPosts(allPosts, post.id);
const related = getRelatedPosts(allPosts, post, 3);
const heroImage = post.data.heroImage?.url?.trim();
const postUrl = new URL(`/notes/${post.id}/`, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedDate.toISOString(),
  dateModified: post.data.updatedDate.toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.url,
  },
  url: postUrl,
  mainEntityOfPage: postUrl,
  keywords: post.data.tags.join(', '),
  ...(heroImage ? { image: new URL(heroImage, Astro.site).href } : {}),
};
---

<AppLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  image={heroImage}
  articlePublishedTime={post.data.publishedDate}
  articleModifiedTime={post.data.updatedDate}
  articleAuthor={SITE.author.name}
  fullWidth
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <ReadingProgress client:load />

  <article class="article-page">
    <ArticleHeader
      category={category}
      theme={categoryTheme}
      title={post.data.title}
      description={post.data.description}
      updatedDate={post.data.updatedDate}
      publishedDate={post.data.publishedDate}
    />

    {heroImage && (
      <figure class="article-page__hero">
        <img
          src={heroImage}
          alt={post.data.heroImage?.alt ?? post.data.title}
          class="article-page__hero-image"
          loading="eager"
        />
        {post.data.heroImage?.alt && (
          <figcaption class="article-page__hero-caption">{post.data.heroImage.alt}</figcaption>
        )}
      </figure>
    )}

    <div class="article-page__canvas">
      <div
        class="article-page__prose-wrap"
        style={`--article-accent: ${categoryTheme.color}; --article-accent-muted: ${categoryTheme.muted}`}
      >
        <div class="prose">
          <Content />
        </div>
      </div>

      <footer
        class="article-page__footer"
        style={`--article-accent: ${categoryTheme.color}; --article-accent-muted: ${categoryTheme.muted}`}
      >
        {post.data.tags.length > 0 && (
          <div class="article-page__tags">
            {post.data.tags.map((tag) => (
              <a href={`/tags/${normalizeTagSlug(tag)}`} class="article-page__tag">#{tag}</a>
            ))}
          </div>
        )}

        <PostFeedbackForm
          postTitle={post.data.title}
          postUrl={postUrl}
          postSlug={post.id}
        />

        <PostNav prev={prev} next={next} />
      </footer>
    </div>

    {related.length > 0 && (
      <div class="article-page__related container">
        <RelatedPosts posts={related} />
      </div>
    )}
  </article>
</AppLayout>

<script>
  import { enhanceArticle } from '../../scripts/enhance-article.ts';

  enhanceArticle();
  document.addEventListener('astro:page-load', enhanceArticle);
</script>
