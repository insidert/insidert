---
import { getCollection } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import BlogListPage from '../../components/blog/BlogListPage.astro';
import { NOTES_PAGE_SIZE } from '../../consts';
import { sortPostsByDate, getAllTags } from '../../lib/posts';

const allPosts = sortPostsByDate(await getCollection('notes'));
const lastPage = Math.ceil(allPosts.length / NOTES_PAGE_SIZE);
const posts = allPosts.slice(0, NOTES_PAGE_SIZE);
const tags = getAllTags(allPosts);
---

<AppLayout
  title="Notes"
  description="Notes on startups, software, entrepreneurship, and building products."
  fullWidth
>
  <BlogListPage posts={posts} currentPage={1} lastPage={lastPage} tags={tags} />
</AppLayout>
