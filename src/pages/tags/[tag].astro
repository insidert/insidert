---
import AppLayout from '../../layouts/AppLayout.astro';
import PostMasonry from '../../components/editorial/PostMasonry.astro';
import FadeIn from '../../components/react/FadeIn';
import { getCollection } from 'astro:content';
import { sortPostsByDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const uniqueTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      posts: sortPostsByDate(posts.filter((post) => post.data.tags.includes(tag))),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<AppLayout
  title={`#${tag}`}
  description={`Posts tagged with ${tag} on Insidert.`}
  fullWidth
>
  <section class="section section--lavender">
    <div class="container container--wide">
      <FadeIn client:visible>
        <div class="tag-header">
          <span class="scribble-label">Topic</span>
          <h1 class="zone-title">#{tag}</h1>
          <p class="tag-count">{posts.length} note{posts.length === 1 ? '' : 's'}</p>
        </div>
      </FadeIn>

      <FadeIn client:visible>
        <PostMasonry posts={posts} heroFirst />
      </FadeIn>
    </div>
  </section>
</AppLayout>

<style>
  .tag-header {
    margin-bottom: var(--space-10);
  }

  .tag-count {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
