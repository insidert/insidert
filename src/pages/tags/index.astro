---
import AppLayout from '../../layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { getAllTags, getTagCounts } from '../../lib/posts';
import { getTagTheme } from '../../lib/topics';
import FadeIn from '../../components/react/FadeIn';

const posts = await getCollection('blog');
const tags = getAllTags(posts);
const tagCounts = getTagCounts(posts);
const totalNotes = posts.length;

const rotations = [-2.4, 1.6, -1.1, 2.2, -0.7, 1.4, -1.9, 0.8, -1.5, 2.6, -0.4, 1.9];
---

<AppLayout title="Tags" description="Browse every topic in the notebook — code, startups, guides, and more." fullWidth>
  <section class="tags-hero section section--lavender">
    <div class="container container--wide">
      <FadeIn client:visible>
        <div class="tags-hero__header">
          <span class="scribble-label">The Index</span>
          <h1 class="zone-title">All Tags</h1>
          <p class="tags-hero__desc">
            Every label in the notebook — pick one and rummage through related notes.
          </p>
          <p class="tags-hero__stats">
            <span class="tags-hero__stat">{tags.length} tags</span>
            <span class="tags-hero__dot" aria-hidden="true">·</span>
            <span class="tags-hero__stat">{totalNotes} notes</span>
          </p>
        </div>
      </FadeIn>
    </div>
  </section>

  <section class="tags-wall section section--cream">
    <div class="container container--wide">
      <div class="tags-wall__board" aria-label="All tags">
        {tags.map((tag, i) => {
          const theme = getTagTheme(tag);
          const count = tagCounts.get(tag) ?? 0;
          const rotation = rotations[i % rotations.length];
          return (
            <FadeIn delay={i * 0.04} client:visible>
              <a
                href={`/tags/${tag}`}
                class="tag-note"
                style={`--tag-color: ${theme.color}; --tag-muted: ${theme.muted}; transform: rotate(${rotation}deg)`}
              >
                <span class="tag-note__tape" aria-hidden="true" />
                <span class="tag-note__label">#{tag}</span>
                <span class="tag-note__count">
                  {count} note{count === 1 ? '' : 's'}
                </span>
              </a>
            </FadeIn>
          );
        })}
      </div>
    </div>
  </section>
</AppLayout>

<style>
  .tags-hero {
    padding-bottom: var(--space-8);
  }

  .tags-hero__header {
    max-width: 36rem;
  }

  .tags-hero__desc {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .tags-hero__stats {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .tags-hero__stat {
    padding: var(--space-1) var(--space-3);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg));
    border: 1px dashed color-mix(in srgb, var(--color-accent) 25%, var(--color-border));
    border-radius: var(--radius-full);
  }

  .tags-hero__dot {
    opacity: 0.4;
  }

  .tags-wall {
    padding-top: var(--space-4);
  }

  .tags-wall__board {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 148px), 1fr));
    gap: var(--space-6) var(--space-5);
    padding: var(--space-8);
    background:
      radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--color-accent) 4%, transparent) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, color-mix(in srgb, var(--color-support) 5%, transparent) 0%, transparent 45%),
      repeating-linear-gradient(
        -3deg,
        transparent,
        transparent 28px,
        color-mix(in srgb, var(--color-border) 40%, transparent) 28px,
        color-mix(in srgb, var(--color-border) 40%, transparent) 29px
      ),
      var(--color-surface-raised);
    border: 2px solid color-mix(in srgb, var(--color-border) 80%, transparent);
    border-radius: var(--radius-xl);
    box-shadow:
      inset 0 2px 8px rgba(28, 25, 23, 0.04),
      var(--shadow-md);
  }

  [data-theme='dark'] .tags-wall__board {
    box-shadow:
      inset 0 2px 12px rgba(0, 0, 0, 0.2),
      var(--shadow-md);
  }

  .tag-note {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 120px;
    padding: var(--space-5) var(--space-4) var(--space-4);
    text-decoration: none;
    text-align: center;
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--tag-color) 12%, var(--color-bg)) 0%,
      color-mix(in srgb, var(--tag-color) 6%, var(--color-surface)) 100%
    );
    border: 1px solid color-mix(in srgb, var(--tag-color) 28%, var(--color-border));
    border-radius: var(--radius-sm);
    box-shadow:
      2px 3px 10px rgba(28, 25, 23, 0.07),
      0 1px 2px rgba(28, 25, 23, 0.04);
    transition:
      transform var(--duration-slow) var(--ease-spring),
      box-shadow var(--duration-slow) var(--ease-out);
  }

  [data-theme='dark'] .tag-note {
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--tag-color) 18%, var(--color-surface-raised)) 0%,
      color-mix(in srgb, var(--tag-color) 8%, var(--color-surface)) 100%
    );
    box-shadow:
      2px 3px 10px rgba(0, 0, 0, 0.3),
      0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .tag-note:hover {
    transform: rotate(0deg) translateY(-6px) scale(1.04) !important;
    box-shadow:
      4px 10px 28px color-mix(in srgb, var(--tag-color) 22%, transparent),
      0 2px 4px rgba(28, 25, 23, 0.06);
    text-decoration: none;
  }

  [data-theme='dark'] .tag-note:hover {
    box-shadow:
      4px 10px 28px color-mix(in srgb, var(--tag-color) 30%, transparent),
      0 2px 4px rgba(0, 0, 0, 0.25);
  }

  .tag-note__tape {
    position: absolute;
    top: -7px;
    left: 50%;
    transform: translateX(-50%) rotate(-1deg);
    width: 44px;
    height: 14px;
    background: color-mix(in srgb, var(--color-text-muted) 22%, transparent);
    border-radius: 1px;
    opacity: 0.55;
  }

  .tag-note__label {
    font-family: var(--font-accent);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--tag-color);
    line-height: var(--leading-snug);
    word-break: break-word;
  }

  .tag-note__count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 640px) {
    .tags-wall__board {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 130px), 1fr));
      gap: var(--space-5);
      padding: var(--space-5);
    }

    .tag-note {
      min-height: 108px;
    }

    .tags-hero__stats {
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-note:hover {
      transform: none !important;
    }
  }
</style>
